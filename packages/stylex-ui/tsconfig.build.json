{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo.build.json"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
